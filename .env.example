# =============================================================================
# backend-turnos - environment variables
# =============================================================================
#
# Copy this file to .env and fill it in with your real values:
#
#   cp .env.example .env
#
# .env is in .gitignore: NEVER commit it. Do not paste here any value that you
# have already uploaded to the repository (if you did, rotate it anyway as if it
# had been exposed).
#
# Golden rules:
#
# - The technical JWT of the catedra, the credentials of the technical account
#   and every password NEVER go into source code, the README, screenshots, logs
#   or the KMP application.
# - All values below are injected as OS environment variables (or via env_file
#   in docker compose) and read with ${VAR} in application.yml.
# - backend-turnos consumes the JWT that backend-catalogo ISSUES to the end
#   user: both services must be configured with the SAME APP_JWT_SECRET.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Database (PostgreSQL 16, server; H2/SQLite in-memory are prohibited)
# -----------------------------------------------------------------------------
# Separate container, separate user and separate database from backend-catalogo:
# neither of the two services can touch the data of the other.

DB_NAME=turnos
DB_USER=turnos
DB_PASSWORD=cambio-una-password-larga-para-desarrollo

# Container port exposed on the host (used when running the service from the IDE).
# 5434 so it never collides with backend-catalogo (5433).
DB_PORT=5434

# JDBC used by the service. Inside docker compose it is automatically overridden
# by jdbc:postgresql://turnos-db:5432/... (see docker-compose.yml).
DB_URL=jdbc:postgresql://localhost:5434/turnos

# HTTP port of backend-turnos (KMP uses 10.0.2.2:8082 from the emulator).
APP_PORT=8082
SERVER_PORT=8082

# Time zone used to decide whether a local appointment slot is still in the future.
# Set this to the time zone where the professional's weekly schedule is expressed.
APP_TIME_ZONE=UTC

# -----------------------------------------------------------------------------
# 2. User JWT (ISSUED by backend-catalogo, VALIDATED by backend-turnos)
# -----------------------------------------------------------------------------
# HS256. MINIMUM 32 characters (256 bits). It MUST be the exact same value as
# APP_JWT_SECRET of backend-catalogo: the tokens of the catalog are validated
# here (signature, expiry and issuer "backend-catalogo").
# Rotating it invalidates the sessions of both services at the same time.

APP_JWT_SECRET=genera-aqui-un-secreto-largo-de-al-menos-32-caracteres

# -----------------------------------------------------------------------------
# 3. CORS
# -----------------------------------------------------------------------------
# Allowed origins, separated by commas. Android does not need CORS; it is used
# for web clients during development. Empty = all cross-origin requests rejected.

CORS_ALLOWED_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# 4. Internal contract of backend-catalogo (section 4.2 of the statement)
# -----------------------------------------------------------------------------
# Source of the current schedule: this service NEVER keeps a copy of the
# catalog. The end user JWT of the incoming request is propagated in
# Authorization, which preserves identity and traceability between services.

CATALOGO_API_BASE_URL=http://localhost:8081
CATALOGO_HTTP_CONNECT_TIMEOUT_MS=3000
CATALOGO_HTTP_READ_TIMEOUT_MS=10000

# -----------------------------------------------------------------------------
# 5. Technical account of the project with the course infrastructure
# -----------------------------------------------------------------------------
# The technical account is shared by both backends of this project. Register it
# ONCE with Postman against the catedra (POST /api/student/register); the step
# by step is documented in backend-catalogo/README.md.

# Base URL of the course REST API (provided by the course through another channel).
CATEDRA_API_BASE_URL=http://localhost:9999

# Option A (recommended): technical login, used to obtain the JWT through
# POST /api/authenticate (rememberMe=true). Leave empty if using Option B.
CATEDRA_LOGIN=alumno.ejemplo
CATEDRA_PASSWORD=clave-tecnica-de-la-catedra

# Option B: an already valid technical JWT (1 year). When set, it takes
# precedence over CATEDRA_LOGIN / CATEDRA_PASSWORD.
CATEDRA_JWT=

# HTTP timeouts towards the course infrastructure (milliseconds).
CATEDRA_HTTP_CONNECT_TIMEOUT_MS=3000
CATEDRA_HTTP_READ_TIMEOUT_MS=10000

# Bounded retry with backoff when OBTAINING the technical token. Calls that have
# an effect (creating a hold) are never blindly retried: they are reconciled by
# the identifiers already persisted (iteration 05).
CATEDRA_RETRY_MAX_ATTEMPTS=3
CATEDRA_RETRY_INITIAL_BACKOFF_MS=300
CATEDRA_RETRY_MAX_BACKOFF_MS=3000

# -----------------------------------------------------------------------------
# 6. Kafka (section 15 of the contract)
# -----------------------------------------------------------------------------
# backend-turnos consumes the appointment-actions topic and publishes phone
# submissions after fetching the current "integration" object with its technical
# account. Bootstrap servers, consumer group and topics are not hardcoded or
# overridden by environment variables.
